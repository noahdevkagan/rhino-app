<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIconFile</key>
	<string>AppIcon.icns</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Audio Files</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.audio</string>
			</array>
		</dict>
	</array>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Rhino needs microphone access to record your dictation. Audio never leaves this Mac.</string>
	<key>NSAccessibilityUsageDescription</key>
	<string>Rhino needs accessibility access to type your dictated text into other apps.</string>
	<key>NSAppleEventsUsageDescription</key>
	<string>Rhino reads the active browser tab's URL to record where a dictation happened and to apply per-site model rules.</string>
	<key>SUFeedURL</key>
	<string>https://raw.githubusercontent.com/my-monkeys/OpenSuperWhisper/master/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>ECQpCBVVumUKoBjgcDPSlmllYiWlSAUFGh5WycBhCA0=</string>
	<!-- Automatic checks OFF while the feed still points at upstream's appcast:
	     a dev/Rhino build must never offer to "update" itself into stock
	     OpenSuperWhisper. Re-enable when SUFeedURL moves to Rhino's own feed. -->
	<key>SUEnableAutomaticChecks</key>
	<false/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- All-local app: every network call is HTTPS to a public host (Sparkle
		     appcast, user-initiated model downloads) except the loopback-only
		     Ollama cleanup backend, which is plain HTTP to localhost. Only local
		     networking is exempted; everything else gets full ATS enforcement. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
